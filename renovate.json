{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "docker:pinDigests"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "packageRules": [
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Ignore requirements.txt - auto-generated from pyproject.toml by poetry-export",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements.txt"],
      "enabled": false
    },
    {
      "description": "Group Python packages",
      "matchManagers": ["pip_setup", "poetry"],
      "groupName": "python dependencies"
    },
    {
      "description": "Keep the Poetry Python support range managed manually",
      "matchManagers": ["poetry"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group Helm chart dependencies",
      "matchManagers": ["helm-values", "helmfile"],
      "groupName": "helm dependencies"
    },
    {
      "description": "Ignore stampbot image in values.yaml - tag intentionally empty to use appVersion",
      "matchManagers": ["helm-values"],
      "matchFileNames": ["charts/stampbot/values.yaml"],
      "matchPackageNames": ["ghcr.io/dannysauer/stampbot"],
      "enabled": false
    },
    {
      "description": "Group Docker updates",
      "matchManagers": ["dockerfile"],
      "groupName": "docker dependencies"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  },
  "schedule": ["before 6am on monday"]
}
